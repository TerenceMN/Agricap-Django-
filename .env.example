# Backend AGRICAP FINTECH — moteur d'analyse crédit (Django)

DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# IdP AGRICAP (OIDC) — validation des jetons déléguée à /userinfo.
IDP_ISSUER=http://localhost:8001
IDP_USERINFO_URL=http://localhost:8001/userinfo
# Durée de cache d'une résolution /userinfo (secondes).
IDP_USERINFO_CACHE_TTL=300

# Origines autorisées pour le SPA FINTECH (CORS).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Dossier des classeurs Excel de référence (pour l'amorçage CLI).
DOCUMENT_EXCEL_DIR=../Document Excel

# --- Plateforme de paiement Makuta (Wolf Technologies) ---------------------
# Signature RSA de nos requêtes (cf. backend/common/makuta.py).
# La clé privée ne va JAMAIS dans le dépôt : PEM en variable d'environnement,
# ou chemin vers un fichier stocké hors webroot.
MAKUTA_BASE_URL=
MAKUTA_PRIVATE_KEY_PEM=
MAKUTA_PRIVATE_KEY_PATH=
MAKUTA_PRIVATE_KEY_PASSPHRASE=
# Clé publique de Makuta, pour authentifier un rappel entrant. Non fournie à ce
# jour : la documentation ne couvre que le sens partenaire -> Makuta.
MAKUTA_CALLBACK_PUBLIC_KEY_PEM=
# La documentation se contredit sur le nom de l'en-tete : X-Makuta-Signature
# dans le tableau normatif, X-Signature dans l'exemple POST. A confirmer.
MAKUTA_SIGNATURE_HEADER=X-Makuta-Signature
